# EditForge — never commit real secrets
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
RUNWAY_API_KEY=
KLING_API_KEY=
VEO_API_KEY=
SEEDREAM_API_KEY=
ARTLIST_API_KEY=
EPIDEMIC_API_KEY=

# Access control — see docs/CLAUDE_INTEGRATION.md
# Set EDITFORGE_ACCESS_PASSWORD to make the whole deployment private.
# Set EDITFORGE_MCP_TOKEN to allow MCP clients to run state-changing tools.
# Billable provider work requires one of these regardless; with neither set,
# only the offline 'mock' provider is reachable.
EDITFORGE_ACCESS_PASSWORD=
EDITFORGE_MCP_TOKEN=

# DEVON -> EditForge -> Railway worker execution boundary
EDITFORGE_WORKER_URL=
EDITFORGE_WORKER_TOKEN=
EDITFORGE_WORKER_CALLBACK_BASE_URL=
EDITFORGE_CALLBACK_ORIGIN=
EDITFORGE_WORKER_CONCURRENCY=1
EDITFORGE_PUBLIC_URL=
EDITFORGE_ARTIFACT_DIR=
EDITFORGE_ARTIFACT_BASE_URL=

# Worker-side provider adapters. Each adapter accepts the locked command,
# identity, canon, operation, and current input artifact and returns a hashed
# output artifact. One shared provider token keeps credentials out of commands.
EDITFORGE_PROVIDER_TOKEN=
EDITFORGE_VOICE_ADAPTER_URL=
EDITFORGE_MOTION_ADAPTER_URL=
EDITFORGE_LIPSYNC_ADAPTER_URL=
EDITFORGE_TIMELINE_ADAPTER_URL=
EDITFORGE_ALLOW_LOCAL_ARTIFACTS=false
EDITFORGE_ALLOW_PRIVATE_MEDIA_URLS=false
EDITFORGE_TRUSTED_MEDIA_ORIGINS=

# Private identity-locked provider adapter used by compose.yaml. Copy
# provider/identity-registry.example.json outside the repository, fill it with
# consented provider IDs, and point this variable at that host file.
EDITFORGE_IDENTITY_REGISTRY_FILE=
EDITFORGE_PROVIDER_MAX_CREDITS_PER_JOB=100
EDITFORGE_VOICE_MAX_CHARACTERS_PER_JOB=5000
RUNWAYML_API_SECRET=
RUNWAY_API_VERSION=2024-11-06
