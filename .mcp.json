{
  "mcpServers": {
    "editforge": {
      "type": "http",
      "url": "${EDITFORGE_MCP_URL:-https://editforge.vercel.app/api/mcp}",
      "headers": {
        "Authorization": "Bearer ${EDITFORGE_MCP_TOKEN:-}"
      }
    },
    "hostinger": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "hostinger-api-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN:-}"
      }
    }
  }
}