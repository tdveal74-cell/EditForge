# EditForge — never commit real secrets.
# Copy to .env.local (Next.js dev) or .env (docker compose) and fill in.
# The full runbook, including which variable belongs to which deployment, is
# docs/CREDENTIALS.md.

# ─── Studio providers ────────────────────────────────────────────────────────
# These are read by the control plane — /gen-video, /voice, /avatar. They are
# separate from the identity-locked DEVON adapter further down, which has its
# own credentials on purpose.

# Gen video. Runway's own SDK name (RUNWAYML_API_SECRET) is accepted too.
RUNWAY_API_KEY=
KLING_API_KEY=
VEO_API_KEY=
SEEDREAM_API_KEY=

# Voice. ELEVENLABS_VOICE_ID is the default provider voice. Any one studio
# voice can be pinned to its own with ELEVENLABS_VOICE_ID_<SLUG> — "vo-auren"
# reads ELEVENLABS_VOICE_ID_AUREN. ElevenLabs answers with the audio itself, so
# EDITFORGE_ARTIFACT_DIR must also be set or a voice run refuses.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_AUREN=
ELEVENLABS_VOICE_ID_VESPERA=
ELEVENLABS_VOICE_ID_STOCK_NARRATOR=

# Avatar. All three are required before a HeyGen render is accepted — the key
# alone is not enough, and a missing look id is not a credential problem.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Stock (index only — no execution boundary yet)
ARTLIST_API_KEY=
EPIDEMIC_API_KEY=

# ─── Access control — see docs/CLAUDE_INTEGRATION.md ─────────────────────────
# Set EDITFORGE_ACCESS_PASSWORD to make the whole deployment private.
# Set EDITFORGE_MCP_TOKEN to allow MCP clients to run state-changing tools.
# Billable provider work requires one of these regardless; with neither set,
# only the offline 'mock' provider is reachable.
EDITFORGE_ACCESS_PASSWORD=
EDITFORGE_MCP_TOKEN=

# ─── Durable store ───────────────────────────────────────────────────────────
# Cuts, jobs and edits. Without these the studio falls back to a file store,
# which is ephemeral and per-instance on Vercel. /api/health reports which is
# active.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── DEVON -> EditForge -> worker execution boundary ─────────────────────────
EDITFORGE_WORKER_URL=
EDITFORGE_WORKER_TOKEN=
EDITFORGE_WORKER_CALLBACK_BASE_URL=
EDITFORGE_CALLBACK_ORIGIN=
EDITFORGE_WORKER_CONCURRENCY=1
EDITFORGE_PUBLIC_URL=

# Where rendered artifacts live, and how they are served back. The control
# plane needs the directory for any provider that returns bytes rather than a
# URL; compose.yaml mounts a shared volume at /artifacts for exactly this.
EDITFORGE_ARTIFACT_DIR=
EDITFORGE_ARTIFACT_BASE_URL=

# Private source media already present on the self-hosted machine. Compose
# mounts this host directory read-only into the web catalog and render worker.
# Example: /root/Media Assets
EDITFORGE_SOURCE_MEDIA_HOST_DIR=./media

# Worker-side provider adapters. Each adapter accepts the locked command,
# identity, canon, operation, and current input artifact and returns a hashed
# output artifact. One shared provider token keeps credentials out of commands.
EDITFORGE_PROVIDER_TOKEN=
EDITFORGE_VOICE_ADAPTER_URL=
EDITFORGE_MOTION_ADAPTER_URL=
EDITFORGE_LIPSYNC_ADAPTER_URL=
EDITFORGE_TIMELINE_ADAPTER_URL=
EDITFORGE_ALLOW_LOCAL_ARTIFACTS=false
EDITFORGE_ALLOW_PRIVATE_MEDIA_URLS=false
EDITFORGE_TRUSTED_MEDIA_ORIGINS=

# Private identity-locked provider adapter used by compose.yaml. Copy
# provider/identity-registry.example.json outside the repository, fill it with
# consented provider IDs, and point this variable at that host file.
EDITFORGE_IDENTITY_REGISTRY_FILE=
# Optional private host image used for Runway Act-Two. Mount it with
# compose.identity-reference.example.yaml; it is never served publicly.
EDITFORGE_RUNWAY_CHARACTER_FILE=
EDITFORGE_PROVIDER_MAX_CREDITS_PER_JOB=100
EDITFORGE_VOICE_MAX_CHARACTERS_PER_JOB=5000
RUNWAYML_API_SECRET=
RUNWAY_API_VERSION=2024-11-06
