# EditForge — never commit real secrets
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
RUNWAY_API_KEY=
# Server-owned cost input. Required before controlled Runway spend can pass.
RUNWAY_COST_PER_SECOND_USD=
KLING_API_KEY=
VEO_API_KEY=
SEEDREAM_API_KEY=
ARTLIST_API_KEY=
EPIDEMIC_API_KEY=

# Access control — see docs/CLAUDE_INTEGRATION.md
# Set EDITFORGE_ACCESS_PASSWORD to make the whole deployment private.
# Set EDITFORGE_MCP_TOKEN to allow MCP clients to run state-changing tools.
# Billable provider work requires one of these regardless; with neither set,
# only the offline 'mock' provider is reachable.
EDITFORGE_ACCESS_PASSWORD=
EDITFORGE_MCP_TOKEN=

# Spend is fail-closed. API keys never unlock paid work by themselves.
EDITFORGE_SPEND_MODE=zero-cost
EDITFORGE_BILLING_ENABLED=false
EDITFORGE_TOTAL_BUDGET_USD=0
EDITFORGE_SPENT_USD=0
EDITFORGE_PER_JOB_LIMIT_USD=0
